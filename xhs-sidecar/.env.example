# Bind to loopback unless the sidecar is protected by a private network boundary.
BASE_REGISTRY=dockerproxy.net/library
XHS_SIDECAR_HOST=127.0.0.1
XHS_SIDECAR_PORT=18081
XHS_COLLECTOR_API_KEY=replace-with-a-long-random-secret

# Extracted Spider_XHS project and the Python interpreter containing its dependencies.
SPIDER_XHS_ROOT=C:\path\to\Spider_XHS-master
SPIDER_XHS_PYTHON=C:\path\to\openclaw_model\xhs-sidecar\.venv\Scripts\python.exe
XHS_COOKIES=
XHS_AUTH_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret
XHS_AUTH_STATE_FILE=C:\path\to\openclaw_model\xhs-sidecar\runtime\jobs\_auth\session.enc
XHS_AUTH_FAILURE_THRESHOLD=2
XHS_AUTH_QR_TTL_SECONDS=180

# Use the same strong secret as the Java application.
XHS_AUTHOR_HASH_KEY=replace-with-a-long-random-secret

XHS_SIDECAR_DATA_DIR=C:\path\to\openclaw_model\xhs-sidecar\runtime\jobs
XHS_SIDECAR_WORKER_TIMEOUT_SECONDS=300
XHS_SIDECAR_WORKER_THREADS=1
XHS_SIDECAR_MAX_QUEUED_JOBS=20
XHS_SIDECAR_JOB_RETENTION_HOURS=168
XHS_COLLECT_COMMENTS=true
XHS_COMMENT_LIMIT=100
XHS_DETAIL_MAX_ATTEMPTS=3
XHS_DETAIL_RETRY_DELAY_MS=800
